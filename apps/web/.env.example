# Provider selection flags — each mock has a documented real-service swap point.
# AuthProvider: "mock" (local dev viem account) | "privy" (Privy + ERC-4337 paymaster)
NEXT_PUBLIC_AUTH_PROVIDER=mock

# DataProvider: "mock" (fixtures) | "subgraph" (deployed GraphQL endpoint)
NEXT_PUBLIC_DATA_PROVIDER=mock

# StorageProvider: "mock" (in-memory) | "pinata" (IPFS via Pinata)
NEXT_PUBLIC_STORAGE_PROVIDER=mock

# Dev-only private key used by the mock AuthProvider to sign EIP-712 payloads.
# This is the well-known Anvil test account #0 — NEVER use in production.
NEXT_PUBLIC_MOCK_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Privy + paymaster (used when NEXT_PUBLIC_AUTH_PROVIDER=privy) ----
# NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_PAYMASTER_URL=

# ---- Subgraph (used when NEXT_PUBLIC_DATA_PROVIDER=subgraph) ----
# NEXT_PUBLIC_SUBGRAPH_URL=

# ---- Pinata (used when NEXT_PUBLIC_STORAGE_PROVIDER=pinata) ----
# NEXT_PUBLIC_PINATA_JWT=
