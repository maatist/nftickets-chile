# -----------------------------------------------------------------------------
# @nftickets/subgraph — deploy & network configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#
# These values describe WHERE the subgraph indexes from and WHERE it deploys to.
# subgraph.yaml ships with placeholder `source.address` (0x0000…0000) and
# `startBlock: 0`; after deploying EventTicketing.sol
# (packages/contracts/script/Deploy.s.sol) substitute the real values below and
# either edit subgraph.yaml directly or template it from these vars at deploy
# time. See README.md → "Connecting real services".
# -----------------------------------------------------------------------------

# The Graph network id the subgraph indexes. Base Sepolia in this project.
GRAPH_NETWORK=base-sepolia

# Deployed EventTicketing contract address on the target network.
# Replace subgraph.yaml `source.address` with this after deployment.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Block in which EventTicketing was created (indexing start block).
# Replace subgraph.yaml `startBlock` with this to avoid scanning from genesis.
START_BLOCK=0

# ---- Deploy target (choose one) ----

# Subgraph Studio (hosted by The Graph): the deploy key from your Studio dashboard.
# Used as: graph deploy --studio <SUBGRAPH_SLUG> --deploy-key "$GRAPH_DEPLOY_KEY"
GRAPH_DEPLOY_KEY=your_studio_deploy_key_here

# The Studio subgraph slug/name to deploy under.
SUBGRAPH_SLUG=nftickets-chile

# ---- Self-hosted graph-node (alternative to Studio) ----
# GRAPH_NODE_URL=http://localhost:8020/
# IPFS_URL=http://localhost:5001/
